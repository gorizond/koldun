+// Reads a positive token cadence from the environment; 0 (disabled) when unset or invalid.
+static unsigned long long readProgressEvery(const char *name) {
+    const char *raw = std::getenv(name);
+    if (raw == nullptr)
+        return 0;
+    char *end = nullptr;
+    long long value = std::strtoll(raw, &end, 10);
+    if (end == raw || value <= 0)
+        return 0;
+    return (unsigned long long)value;
+}
