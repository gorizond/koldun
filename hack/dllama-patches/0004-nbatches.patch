+static NnUint parseNBatches() {
+    const char *raw = std::getenv("DLLAMA_N_BATCHES");
+    if (raw == nullptr)
+        return 32;
+    char *end = nullptr;
+    long value = std::strtol(raw, &end, 10);
+    if (end == raw || value < 1 || value > 256)
+        return 32;
+    return (NnUint)value;
+}
