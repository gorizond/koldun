+static void configureHttpClientSocket(int socket) {
+#ifndef _WIN32
+    // A slow model can take tens of minutes; outlive worker weight loading and
+    // the llm sidecar request timeout instead of failing the request early.
+    long timeoutSeconds = 20 * 60;
+    if (const char *env = std::getenv("DLLAMA_HTTP_READ_TIMEOUT_SECONDS")) {
+        char *end = nullptr;
+        long parsed = std::strtol(env, &end, 10);
+        if (end != env && parsed > 0)
+            timeoutSeconds = parsed;
+    }
+    struct timeval timeout;
+    timeout.tv_sec = timeoutSeconds;
+    timeout.tv_usec = 0;
+    setsockopt(socket, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+#endif
+}
+
+const int maxHttpConnections = 8;
+
+// Inference is stateful; /v1/models and other metadata routes do not touch the
+// inference engine and may run concurrently with a long chat prefill.
+static bool requiresInferenceLock(const char *path) {
+    return std::strcmp(path, "/v1/chat/completions") == 0;
+}
+
+struct HttpServerState {
+    std::vector<Route> routes;
+    std::mutex inferenceMutex;
+    std::mutex activeMutex;
+    std::condition_variable activeCv;
+    std::atomic<bool> fatal{false};
+    int listenFd = -1;
+    int active = 0;
+};
+
+static void handleHttpClient(int fd, std::shared_ptr<HttpServerState> state) {
+    NnSocket clientSocket(fd);
+    try {
+        configureHttpClientSocket(clientSocket.fd);
+
+        HttpRequest request = HttpRequest::read(clientSocket.fd);
+        printf("🔷 %s %s\n", request.getMethod().c_str(), request.path.c_str());
+        if (requiresInferenceLock(request.path.c_str())) {
+            // Serialise chat requests while still serving /v1/models and
+            // health checks from other threads.
+            std::lock_guard<std::mutex> lock(state->inferenceMutex);
+            Router::resolve(request, state->routes);
+        } else {
+            Router::resolve(request, state->routes);
+        }
+    } catch (const NnTransferSocketException& e) {
+        printf("Socket error: %d %s\n", e.code, e.what());
+    } catch (const NnExecutorException &e) {
+        // The root must rebuild its network, exactly as the upstream main loop
+        // did before HTTP serving became threaded. Signal server() to stop
+        // accepting and wake it from acceptSocket().
+        printf("🚨 Inference error: %s; restarting network\n", e.what());
+        state->fatal.store(true);
+        shutdown(state->listenFd, 2);
+    } catch (const std::exception &e) {
+        // A client disconnect (llm sidecar timeout, pod shutdown) must not
+        // terminate dllama-api: answer 503 so callers can retry and keep
+        // serving subsequent requests.
+        printf("🚨 HTTP client error: %s\n", e.what());
+        if (clientSocket.fd >= 0) {
+            const char *response = "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
+            send(clientSocket.fd, response, std::strlen(response), 0);
+        }
+    }
+}
