export KUBEBUILDER_ASSETS="$(./hack/print-kubebuilder-assets.sh)"

# Reuse docker-compose NATS for dispatcher tests when set in the shell profile.
# Direnv users can place `export KOLDUN_NATS_URL="nats://koldun:koldun@127.0.0.1:4222"`
# (see README compose workflow). Dispatcher helpers will pick it up automatically.
if [[ -n "${KOLDUN_NATS_URL:-}" && -z "${KOLDUN_DISPATCHER_NATS_URL:-}" ]]; then
  export KOLDUN_DISPATCHER_NATS_URL="$KOLDUN_NATS_URL"
fi
